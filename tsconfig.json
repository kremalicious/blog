{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@config/*": ["config/*"],
      "@content/*": ["content/*"],
      "@test/*": ["test/*"]
    },
    "types": ["astro/client", "@types/bun"]
  },
  "include": [
    "src/**/*",
    "content/**/*",
    "public/**/*",
    "scripts/**/*",
    "test/**/*",
    "config/**/*",
    ".astro/types.d.ts"
  ],
  "exclude": ["src/images/components/**/*"]
}
