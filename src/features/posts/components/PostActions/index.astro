---
import { GithubIcon } from '@lucide/astro'
import { metadata } from '@/config'
import BitcoinIcon from '@/images/bitcoin.svg'
import MastodonIcon from '@/images/mastodon.svg'
import type { BlogPost } from '../../types'
import Action from './Action.astro'
import styles from './index.module.css'

type Props = {
  githubLink: BlogPost['data']['githubLink']
}

const { githubLink } = Astro.props

const actions = [
  {
    title: 'Have a comment?',
    text: 'Hit me up @krema@mas.to',
    url: metadata.author.mastodon,
    icon: MastodonIcon
  },
  {
    title: 'Found something useful?',
    text: 'Say thanks with BTC or ETH',
    url: '/thanks/',
    icon: BitcoinIcon
  },
  {
    title: 'Edit on GitHub',
    text: 'Contribute to this post',
    url: githubLink,
    icon: GithubIcon
  }
]
---

<section class:list={[styles.actions, "breakout"]}>
  {
    actions.map((action) => (
      <Action
        title={action.title}
        text={action.text}
        url={action.url}
        icon={action.icon}
      />
    ))
  }
</section>
