---
import { GithubIcon } from '@lucide/astro'
import { metadata } from '@/config'
import MastodonIcon from '@/images/mastodon.svg'
import TipJarIcon from '@/images/tipjar.svg'
import type { BlogPost } from '../../types'
import Action from './Action.astro'

type Props = {
  githubLink: BlogPost['data']['githubLink']
}

const { githubLink } = Astro.props

const actions = [
  {
    title: 'Have a comment?',
    text: 'Hit me up @krema@mas.to',
    url: metadata.author.mastodon,
    icon: MastodonIcon
  },
  {
    title: 'Found something useful?',
    text: 'Send some tips',
    url: '/tipjar/',
    icon: TipJarIcon
  },
  {
    title: 'Edit on GitHub',
    text: 'Contribute to this post',
    url: githubLink,
    icon: GithubIcon
  }
]
---

<section class:list={["actions", "breakout"]}>
  {
    actions.map((action) => (
      <Action
        title={action.title}
        text={action.text}
        url={action.url}
        icon={action.icon}
      />
    ))
  }
</section>

<style>
  .actions {
    margin-top: var(--space-l);
    margin-bottom: var(--space-2xl);
    background: var(--box-background-color);
    padding: var(--space-l) var(--space-m);
    border-radius: var(--border-radius);
    border: var(--border-width) solid var(--border-color);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: var(--space-xs);
  }
</style>
