---
import Picture from '@/components/ui/Picture/index.astro'
import type { SearchResultItem } from '@/features/search/types'
import { PostHeader } from '../../components'
import type { ArticlePost, LinkPost } from '../../types'
import styles from './index.module.css'

type Props = {
  post: ArticlePost | LinkPost | SearchResultItem
  hideDate?: boolean
}

const { post, hideDate } = Astro.props
const { title, date, updated, slug } = post.data
const image = 'image' in post.data ? post.data.image : undefined
---

<a class={styles.post} href={`/${slug}/`}>
  {
    image ? (
      <Picture
        class={styles.image}
        src={image}
        alt={`Teaser for ${title}`}
        width={686}
        height={200}
        objectFit
      />
    ) : null
  }

  <PostHeader
    title={title}
    date={hideDate ? undefined : date}
    updated={updated}
    className={styles.title}
    as="h3"
  />
</a>
