---
import Fuse from 'fuse.js'
import { getAllPostsForSearch } from '@/features/search/lib/get-search-posts'
import { PostTeaser } from '../../components'
import type { BlogPost } from '../../types'
import styles from './index.module.css'

type Props = {
  post: BlogPost
}

const { post } = Astro.props as Props
const allSearchPosts = await getAllPostsForSearch()
const allSearchPostsWithoutCurrent = allSearchPosts?.filter(
  (p) => p.data.slug !== post.data.slug
)

// Configure fuse.js
// https://fusejs.io/api/options.html
const fuse = new Fuse(allSearchPostsWithoutCurrent, {
  keys: ['data.tags', 'data.title', 'data.leadRaw'],
  useExtendedSearch: true,
  threshold: 0.6
})

const relatedPosts = fuse
  // https://www.fusejs.io/examples.html#extended-search
  .search(`${post?.data?.tags?.join(' | ')} | "${post?.data?.title}"`)
  .map((result) => result.item)
  .slice(0, 6)
---

<section class={styles.relatedPosts}>
  <h3 class={styles.title}>Related</h3>
  <ul>
    {
      relatedPosts?.map((post) => (
        <li>
          <PostTeaser post={post} hideDate />
        </li>
      ))
    }
  </ul>
</section>
