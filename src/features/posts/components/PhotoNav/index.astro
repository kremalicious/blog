---
import Picture from '@/components/ui/Picture/index.astro'
import type { PhotoPost } from '@/features/posts/types'
import { getCollectionEnhanced } from '../../lib'
import styles from './index.module.css'

type Props = {
  currentPhoto: PhotoPost
}

const { currentPhoto } = Astro.props
const { slug, title, image } = currentPhoto.data

const allPhotos = (await getCollectionEnhanced('photos')) as PhotoPost[]
const currentIndex = allPhotos.findIndex((photo) => photo.data.slug === slug)

// Get up to 6 photos before and 6 photos after the current photo
const prevPhotos = allPhotos.slice(currentIndex + 1, currentIndex + 7)
const nextPhotos = allPhotos.slice(Math.max(0, currentIndex - 6), currentIndex)
---

<div class:list={[styles.photoNavContainer, "breakout"]}>
  <div class={styles.photoNav} id="photo-nav">
    {
      nextPhotos.map((photo) => (
        <a
          href={`/${photo.data.slug}/`}
          class={styles.photoLink}
          title={photo.data.title}
        >
          <Picture
            width={100}
            height={100}
            src={photo.data.image}
            alt={photo.data.title}
            objectFit
          />
        </a>
      ))
    }

    <a
      href={`/${slug}/`}
      class={`${styles.photoLink} ${styles.currentPhoto}`}
      title={title}
      id="current-photo"
    >
      <Picture width={100} height={100} src={image} alt={title} objectFit/>
    </a>

    {
      prevPhotos.map((photo) => (
        <a
          href={`/${photo.data.slug}/`}
          class={styles.photoLink}
          title={photo.data.title}
        >
          <Picture
            width={100}
            height={100}
            src={photo.data.image}
            alt={photo.data.title}
            objectFit
          />
        </a>
      ))
    }
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const photoNav = document.getElementById('photo-nav')
    const currentPhoto = document.getElementById('current-photo')

    if (!photoNav || !currentPhoto) return

    // Center the current photo in the view
    function centerCurrentPhoto() {
      if (!photoNav || !currentPhoto) return

      const photoRect = currentPhoto.getBoundingClientRect()
      const containerRect = photoNav.getBoundingClientRect()

      const scrollPosition =
        photoNav.scrollLeft +
        (photoRect.left - containerRect.left) -
        containerRect.width / 2 +
        photoRect.width / 2

      photoNav.scrollLeft = scrollPosition
    }

    window.addEventListener('load', centerCurrentPhoto)
    window.addEventListener('resize', centerCurrentPhoto)
  })
</script>
