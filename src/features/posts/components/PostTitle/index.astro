---
import ExternalLink from 'feather-icons/dist/icons/external-link.svg'
import { PostDate } from '../../components'
import styles from './index.module.css'

type Props = {
  linkurl?: string
  title: string
  date?: Date
  updated?: Date
  className?: string
  as?: string
}

const { linkurl, title, date, updated, className, as } = Astro.props
const linkHostname = linkurl ? new URL(linkurl).hostname : null
const Element = as || 'h1'
---

{
  linkurl ? (
    <>
      <Element
        class={`${styles.title} ${styles.titleLink} ${className && className}`}
      >
        <a href={linkurl} title={`Go to source: ${linkurl}`}>
          {title} <ExternalLink />
        </a>
      </Element>
      <div class={styles.linkurl}>{linkHostname}</div>
    </>
  ) : (
    <>
      <Element class={`${styles.title} ${className && className}`}>
        {title}
      </Element>
      {date && <PostDate date={date} updated={updated} />}
    </>
  )
}
