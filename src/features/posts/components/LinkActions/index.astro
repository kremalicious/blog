---
import { ExternalLinkIcon, LinkIcon } from '@lucide/astro'
import type { LinkPost } from '../../types'
import styles from './index.module.css'

type Props = {
  linkurl?: LinkPost['data']['linkurl']
  slug: LinkPost['data']['slug']
}

const { slug, linkurl } = Astro.props
---

<div class={styles.postLinkActions}>
  <a href={linkurl}>
    Go to source <ExternalLinkIcon/>
  </a>
  <a href={`/${slug}/`} rel="tooltip" title="Permalink">
    <LinkIcon/>
  </a>
</div>
