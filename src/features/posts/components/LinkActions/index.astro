---
import ExternalLink from 'feather-icons/dist/icons/external-link.svg'
import Link from 'feather-icons/dist/icons/link.svg'
import type { LinkEntry } from '../../types'
import styles from './index.module.css'

type Props = {
  linkurl?: LinkEntry['data']['linkurl']
  slug: LinkEntry['data']['slug']
}

const { slug, linkurl } = Astro.props
---

<div class={styles.postLinkActions}>
  <a href={linkurl}>
    Go to source <ExternalLink />
  </a>
  <a href={`/${slug}/`} rel="tooltip" title="Permalink">
    <Link />
  </a>
</div>
