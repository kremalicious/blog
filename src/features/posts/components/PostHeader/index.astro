---
import { ExternalLinkIcon } from '@lucide/astro'
import { PostDate } from '../../components'
import type { BlogPost, LinkPost } from '../../types'
import styles from './index.module.css'

type Props = {
  title: BlogPost['data']['title']
  date: BlogPost['data']['date']
  updated?: BlogPost['data']['updated']
  linkurl?: LinkPost['data']['linkurl']
  className?: string
  as?: string
}

const { linkurl, title, date, updated, className, as } = Astro.props as Props

const linkHostname = linkurl ? new URL(linkurl).hostname : null
const Element = as || 'h1'
---

<header class={styles.header}>
  {
    linkurl ? (
      <>
        <Element
          class:list={[styles.title, styles.titleLink, className && className]}
        >
          <a href={linkurl} title={`Go to source: ${linkurl}`}>
            {title} <ExternalLinkIcon />
          </a>
        </Element>
        <div class={styles.linkurl}>{linkHostname}</div>
      </>
    ) : (
      <>
        <Element class:list={[styles.title, className && className]}>
          {title}
        </Element>
        {date && <PostDate date={date} updated={updated} />}
      </>
    )
  }
</header>
