---
import type { ImageMetadata } from 'astro'
import Picture from '@/components/ui/Picture/index.astro'

interface Props {
  src: ImageMetadata
  alt: string
  width: number
  height: number
  loading: 'lazy' | 'eager'
  isPhoto?: boolean
}

const { src, alt, width, height, loading, isPhoto } = Astro.props
---

<div class:list={["postImage", isPhoto ? "photoImage" : "", "breakout"]}>
  <Picture src={src} alt={alt} width={width} height={height} loading={loading}/>
</div>

<style>
  .postImage {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-xl);
  }

  .photoImage {
    margin-bottom: 0;
  }

  .photoImage :global(img) {
    max-height: 100vh;
    width: auto;
  }
</style>
