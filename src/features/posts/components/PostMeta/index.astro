---
import config from '@/config/blog.config'
import type { BlogEntry } from '@/features/posts/types'
import { slugify } from '@/lib/slugify'
import { PostDate, Tag } from '../../components'
import styles from './index.module.css'

type Props = {
  post: BlogEntry
}

const { post } = Astro.props
const { date, updated, author, tags } = post.data
---

<footer class={styles.entryMeta}>
  <div class={styles.byline}>
    <span class={styles.by}>by</span>
    <a class="fn" rel="author" href={config.author.url}>
      {author || config.author.name}
    </a>
  </div>

  <PostDate date={date} updated={updated} />

  {
    tags && (
      <div class={styles.tags}>
        {tags.map((tag: string) => (
          <Tag name={slugify(tag)} url={`/tags/${slugify(tag)}/`} />
        ))}
      </div>
    )
  }
</footer>
