---
import { getGitHubRepo, markdownToHtml } from '../../lib'
import styles from './index.module.css'

type Props = {
  repo: string
}

const { repo } = Astro.props
const repoInfo = await getGitHubRepo(repo)
if (!repoInfo) console.error(`Repo ${repo} not found`)

const changelogHtml =
  repoInfo?.object != null
    ? await markdownToHtml(repoInfo.object.text.replace('### Changelog', ''))
    : null
---

{
  repoInfo ? (
    <>
      <h2 class={styles.title}>Changelog</h2>
      <div class={styles.changelog} id="changelog">
        <p class={styles.source}>
          sourced from{" "}
          <a href={`${repoInfo.url}/tree/main/CHANGELOG.md`}>
            <code>{`${repo}:CHANGELOG.md`}</code>
          </a>
        </p>
        <div class={styles.content} set:html={changelogHtml} />
      </div>
      <button class="link" id="changelog-all">
        Show all
      </button>
    </>
  ) : null
}

<script>
  const changelog = document.querySelector('#changelog')
  const button = document.querySelector('#changelog-all')

  button?.addEventListener('click', () => {
    changelog?.classList.add('all')
    button?.remove()
  })
</script>
