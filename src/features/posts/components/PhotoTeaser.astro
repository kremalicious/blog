---
import Picture from '@/components/Picture/index.astro'
import type { PhotoPost } from '../types'

type Props = {
  post: PhotoPost
}

const { title, image, slug } = Astro.props.post.data
---

<style>
  .photo {
    display: block;
  }
</style>

{
  image ? (
    <a class="photo" href={`/${slug}/`}>
      <Picture
        width={202}
        height={202}
        src={image}
        alt={`Photo for ${title}`}
        title={title}
        objectFit
      />
    </a>
  ) : null
}
