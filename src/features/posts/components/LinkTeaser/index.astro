---
import { render } from 'astro:content'
import { LinkActions, PostTitle } from '@/features/posts/components'
import type { BlogEntry } from '@/features/posts/types'
import styles from './index.module.css'

type Props = {
  post: BlogEntry & { data: { linkurl: string } }
  hideDate?: boolean
}

const { post, hideDate } = Astro.props
const { slug } = post
const { title, date, updated, linkurl } = post.data
const { Content } = await render(post)
---

<article class={styles.post}>
  <PostTitle
    title={title}
    date={hideDate ? undefined : date}
    updated={updated}
    linkurl={linkurl}
    className={styles.title}
    as="h3"
  />
  <Content />
  <LinkActions slug={slug} linkurl={linkurl} />
</article>
