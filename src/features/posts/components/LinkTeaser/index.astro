---
import { render } from 'astro:content'
import { LinkActions, PostHeader } from '@/features/posts/components'
import type { LinkPost } from '@/features/posts/types'
import styles from './index.module.css'

type Props = {
  post: LinkPost
  hideDate?: boolean
}

const { post, hideDate } = Astro.props
const { title, date, updated, linkurl, slug } = post.data
const { Content } = await render(post)
---

<article class={styles.post}>
  <PostHeader
    title={title}
    date={hideDate ? undefined : date}
    updated={updated}
    linkurl={linkurl}
    className={styles.title}
    as="h3"
  />
  <Content />
  <LinkActions slug={slug} linkurl={linkurl} />
</article>
