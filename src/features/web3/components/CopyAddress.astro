---
import { CopyButton } from '@/components/ui'

type Props = {
  address: string
}

const { address }: Props = Astro.props
---

<style>
  .code {
    position: relative;
    padding: 0;
    width: 100%;
  }

  .code code {
    display: block;
    padding: var(--space-xs) var(--space-s);
    padding-right: 2rem;
    font-size: var(--fs--2);
    line-height: var(--fs-0);
  }
</style>

<div class="code">
  <code>{address}</code>
  <CopyButton text={address}/>
</div>
