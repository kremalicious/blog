---
import CopyIcon from 'feather-icons/dist/icons/copy.svg'

type Props = {
  text: string
}

const { text } = Astro.props as Props
---

<copy-button>
  <button class="button" title="Copy to clipboard" data-text={text}>
    <CopyIcon />
  </button>
</copy-button>

<script src="./copy-button.ts"></script>

<style>
  .button {
    padding: calc(var(--spacer) / 3);
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
  }

  .button svg {
    stroke: var(--text-color-light);
    transition: 0.15s ease-out;
  }

  .copied {
    background: green;
  }

  .copied svg {
    stroke: var(--text-color-dimmed);
  }

  .button:hover svg {
    stroke: var(--text-color-dimmed);
  }
</style>
