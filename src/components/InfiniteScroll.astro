---
/**
 * InfiniteScroll component for loading more content as the user scrolls
 */

type Props = {
  currentPage: number
  lastPage: number
  baseUrl: string
  contentSelector?: string
}

const {
  currentPage,
  lastPage,
  baseUrl,
  contentSelector = '#posts'
} = Astro.props

const showInfiniteScroll = lastPage > 1
---

{
  showInfiniteScroll && (
    <div class="infinite-scroll-container">
      <div
        id="infinite-scroll-sentinel"
        data-current-page={currentPage}
        data-last-page={lastPage}
        data-base-url={baseUrl}
        data-content-selector={contentSelector}
      />
      <div
        id="infinite-scroll-loading"
        style="display: none; text-align: center; padding: 1rem;"
      >
        <div class="loading-spinner" />
        <p>Loading more content...</p>
      </div>
    </div>
  )
}

<style>
  .loading-spinner {
    display: inline-block;
    width: 2rem;
    height: 2rem;
    border: 0.25rem solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    border-top-color: #333;
    animation: spin 1s ease-in-out infinite;
    margin-bottom: 0.5rem;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  // Wait for the DOM to be fully loaded
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initInfiniteScroll);
  } else {
    initInfiniteScroll();
  }

  function initInfiniteScroll() {
    const sentinel = document.getElementById("infinite-scroll-sentinel");
    const loadingIndicator = document.getElementById("infinite-scroll-loading");

    // Exit if elements are not found
    if (!sentinel || !loadingIndicator) return;

    // Extract data attributes
    const currentPageStr = sentinel.getAttribute("data-current-page") || "1";
    const lastPageStr = sentinel.getAttribute("data-last-page") || "1";
    const baseUrl = sentinel.getAttribute("data-base-url") || "";
    const contentSelector =
      sentinel.getAttribute("data-content-selector") || "#posts";

    let currentPage = parseInt(currentPageStr, 10);
    const lastPage = parseInt(lastPageStr, 10);

    // Exit if we're already on the last page
    if (currentPage >= lastPage) return;

    let isLoading = false;

    // Create observer to detect when user scrolls near bottom
    const observer = new IntersectionObserver(
      function (entries) {
        const shouldLoad =
          // Check if sentinel is visible and we're not already loading
          entries[0].isIntersecting && !isLoading && currentPage < lastPage;

        if (shouldLoad) loadNextPage();
      },
      { rootMargin: "200px", threshold: 0.1 },
    );

    // Start observing the sentinel element
    observer.observe(sentinel);

    async function loadNextPage() {
      if (isLoading || currentPage >= lastPage) return;

      try {
        isLoading = true;
        if (loadingIndicator) loadingIndicator.style.display = "block";

        // Calculate next page number
        const nextPage = currentPage + 1;
        const nextPageUrl = `${baseUrl}${nextPage}/`;

        const response = await fetch(nextPageUrl);
        if (!response.ok)
          throw new Error(`HTTP error! status: ${response.status}`);

        const html = await response.text();

        // Parse the HTML and extract the content
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, "text/html");

        // Find the posts container in the fetched page
        const newContent = doc.querySelector(contentSelector);

        if (!newContent) {
          console.error(
            `[InfiniteScroll] Content container not found in fetched page`,
          );
          return;
        }

        // Find our current content container
        const container = document.querySelector(contentSelector);

        if (!container) {
          console.error(
            `[InfiniteScroll] Content container not found in current page`,
          );
          return;
        }

        // Append the new content
        const children = Array.from(newContent.children);

        children.forEach((child) => {
          const clone = child.cloneNode(true);
          container.appendChild(clone);
        });

        console.log(`[InfiniteScroll] Added ${children.length} items`);

        // Update the current page
        currentPage = nextPage;
        if (sentinel)
          sentinel.setAttribute("data-current-page", currentPage.toString());

        // If we've reached the last page, disconnect the observer
        if (currentPage >= lastPage) observer.disconnect();
      } catch (error) {
        console.error("[InfiniteScroll] Error:", error);
      } finally {
        isLoading = false;
        if (loadingIndicator) loadingIndicator.style.display = "none";
      }
    }
  }
</script>
