---
import Picture from '@/components/Picture/index.astro'
import PostTitle from '@/components/Title/index.astro'
import type { SearchResultItem } from '@/lib/astro/getAllPostsForSearch'
import type { BlogEntry } from '@config/content.schema'
import styles from './index.module.css'

type Props = {
  post: BlogEntry | SearchResultItem
  hideDate?: boolean
}

const { post, hideDate } = Astro.props
const { slug } = post
const { title, date, updated } = post.data
const image = 'image' in post.data ? post.data.image : undefined
---

<a class={styles.post} href={`/${slug}/`}>
  {
    image ? (
      <Picture
        class={styles.image}
        src={image}
        alt={`Teaser for ${title}`}
        width={686}
        height={200}
        objectFit
      />
    ) : null
  }

  <PostTitle
    title={title}
    date={hideDate ? undefined : date}
    updated={updated}
    className={styles.title}
  />
</a>
