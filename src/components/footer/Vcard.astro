---
import { Image } from 'astro:assets'
import { metadata } from '@/config'
import { Location } from '@/features/location/components'
import avatar from '@/images/avatar.jpg'
import Networks from './Networks.astro'
import styles from './Vcard.module.css'

const { author, rss, jsonfeed } = metadata
const { mastodon, github, name, url } = author
const links = [mastodon, github, rss, jsonfeed]
---

<div class={styles.vcard}>
  <Image
    class={styles.avatar}
    src={avatar}
    width="160"
    height="160"
    alt="avatar"
  />

  <p class={styles.description}>
    {metadata.siteDescription.replace(name, "")}<br />
    <a class="fn" rel="author me" href={url}>
      {name}
    </a>
  </p>
</div>

<Location client:visible />

<Networks links={links} />
