---
import type { MarkdownHeading } from 'astro'
import {
  Changelog,
  PostActions,
  PostHeader,
  PostImage,
  PostLead,
  PostMeta,
  RelatedPosts,
  Toc
} from '@/features/posts/components'
import type { ArticlePost } from '@/features/posts/types'
import LayoutBase from './Base/index.astro'

type Props = {
  post: ArticlePost
  headings: MarkdownHeading[]
  lead: string
  leadRaw: string
}

const { post, headings, lead, leadRaw } = Astro.props
const { title, date, updated, image, toc, githubLink, changelog } = post.data
---

<LayoutBase post={post} description={leadRaw}>
  <article>
    <PostHeader title={title} date={date} updated={updated}/>
    <PostLead lead={lead}/>

    {
      image && (
        <PostImage
          width={1016}
          height={324}
          src={image}
          alt={title}
          loading="eager"
        />
      )
    }

    {toc && headings && <Toc headings={headings} />}

    <div class="markdown">
      <slot/>
    </div>

    {changelog && <Changelog repo={changelog} />}

    <PostMeta post={post}/>

    <PostActions githubLink={githubLink}/>

    <RelatedPosts post={post}/>
  </article>
</LayoutBase>
