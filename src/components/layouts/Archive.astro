---
import type { Page } from 'astro'
import { Pagination } from '@/components/ui'
import {
  LinkTeaser,
  PhotoTeaser,
  PostTeaser
} from '@/features/posts/components'
import type { BlogPost } from '@/features/posts/types'
import LayoutBase from './Base/index.astro'

type Props = {
  page: Page<BlogPost>
  title: string
  pageTitle?: string
}

const { page, title, pageTitle } = Astro.props
const isPhotos = title && title !== '' && title.toLowerCase().includes('photos')
---

<LayoutBase title={title} pageTitle={pageTitle}>
  <div id="posts" class:list={["posts", isPhotos ? "photos" : ""]}>
    {
      page?.data?.map((post) =>
        post.collection === "photos" ? (
          <PhotoTeaser post={post} />
        ) : post.collection === "links" ? (
          <LinkTeaser post={post} />
        ) : (
          <PostTeaser post={post} />
        )
      )
    }
  </div>

  {
    page.currentPage && !isPhotos && (
      <Pagination
        currentPage={page.currentPage}
        numPages={page.lastPage}
        slug={`/${Astro.url.pathname.split("/")[1]}`}
      />
    )
  }

  <slot />
</LayoutBase>

<style>
  .posts:not(.photos) > * {
    margin-bottom: var(--space-2xl);
  }

  .photos {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 40rem) {
    .photos {
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    }
  }
</style>
