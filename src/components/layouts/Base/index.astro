---
import '@/styles/global.css'
import '@/styles/imports.css'

import Footer from '@/components/footer/Footer.astro'
import Header from '@/components/header/Header.astro'
import Head from '@/components/seo/Head.astro'
import type { ArticlePost, BlogPost, PhotoPost } from '@/features/posts/types'
import styles from './index.module.css'

export type Props = {
  post?: BlogPost
  title?: string
  description?: string
}

const { post, title, description } = Astro.props
---

<html lang="en">
  <Head
    title={title || post?.data.title}
    description={description}
    date={post?.data.date}
    updated={post?.data.updated}
    image={(post?.data as ArticlePost["data"] | PhotoPost["data"])?.image}
    style={post?.data.style}
  />
  <body>
    <Header/>

    <main class={styles.document} id="document">
      <div class={styles.content}>
        <slot/>
      </div>
    </main>

    <Footer/>
  </body>
</html>
