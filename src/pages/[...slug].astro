---
import { render } from 'astro:content'
import { getAllPosts } from '@/features/posts/lib'
import { ArticleLayout, LinkLayout, PhotoLayout } from '@/layouts'

export async function getStaticPaths() {
  const allPosts = await getAllPosts()

  return allPosts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post }
  }))
}

const { post } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(post)

// Add the remark plugin frontmatter data
const lead = remarkPluginFrontmatter.lead || undefined
const leadRaw = remarkPluginFrontmatter.leadRaw || undefined
---

{
  post.collection === "articles" && (
    <ArticleLayout
      post={post}
      headings={headings}
      lead={lead}
      leadRaw={leadRaw}
    >
      <Content />
    </ArticleLayout>
  )
}

{
  post.collection === "links" && (
    <LinkLayout post={post} leadRaw={leadRaw}>
      <Content />
    </LinkLayout>
  )
}

{
  post.collection === "photos" && (
    <PhotoLayout post={post} leadRaw={leadRaw}>
      <Content />
    </PhotoLayout>
  )
}
