---
import { render } from 'astro:content'
import { getAllPosts } from '@/features/posts/lib'
import LayoutArticle from '@/layouts/Article/index.astro'
import LayoutLink from '@/layouts/Link/index.astro'
import LayoutPhoto from '@/layouts/Photo/index.astro'

export async function getStaticPaths() {
  const allPosts = await getAllPosts()

  return allPosts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post }
  }))
}

const { post } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(post)

// Add the remark plugin frontmatter data
const lead = remarkPluginFrontmatter.lead || undefined
const leadRaw = remarkPluginFrontmatter.leadRaw || undefined
---

{
  post.collection === "articles" && (
    <LayoutArticle
      post={post}
      headings={headings}
      lead={lead}
      leadRaw={leadRaw}
    >
      <Content />
    </LayoutArticle>
  )
}

{
  post.collection === "links" && (
    <LayoutLink post={post} leadRaw={leadRaw}>
      <Content />
    </LayoutLink>
  )
}

{
  post.collection === "photos" && (
    <LayoutPhoto post={post} leadRaw={leadRaw}>
      <Content />
    </LayoutPhoto>
  )
}
