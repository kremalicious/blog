---
import { render } from 'astro:content'
import LayoutArticle from '@/layouts/Article/index.astro'
import LayoutLink from '@/layouts/Link/index.astro'
import LayoutPhoto from '@/layouts/Photo/index.astro'
import { getAllPosts } from '@/lib/astro'

export async function getStaticPaths() {
  const allPosts = await getAllPosts()

  return allPosts.map((entry) => {
    if (!entry?.slug) throw new Error('Missing `slug` field in entry')

    return {
      params: { slug: entry.slug },
      props: { entry }
    }
  })
}

const { entry } = Astro.props
const { Content, remarkPluginFrontmatter } = await render(entry)

// Add the remark plugin frontmatter data
const lead = remarkPluginFrontmatter.lead || undefined
const leadRaw = remarkPluginFrontmatter.leadRaw || undefined
const tableOfContents = remarkPluginFrontmatter.tableOfContents || undefined
---

{
  entry.collection === "articles" && (
    <LayoutArticle
      {...entry}
      lead={lead}
      leadRaw={leadRaw}
      tableOfContents={tableOfContents}
    >
      <Content />
    </LayoutArticle>
  )
}

{
  entry.collection === "links" && (
    <LayoutLink {...entry}>
      <Content />
    </LayoutLink>
  )
}

{
  entry.collection === "photos" && (
    <LayoutPhoto {...entry}>
      <Content />
    </LayoutPhoto>
  )
}
