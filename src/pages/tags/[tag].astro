---
import type { InferGetStaticParamsType, Page } from 'astro'
import { getAllTags, getPostsByTag } from '@/features/posts/lib'
import type { BlogPost } from '@/features/posts/types'
import { ArchiveLayout } from '@/layouts'

type Props = {
  page: Page<BlogPost>
}
type Params = InferGetStaticParamsType<typeof getStaticPaths>

export async function getStaticPaths() {
  const allUniqueTags = await getAllTags()

  return await Promise.all(
    allUniqueTags.map(async (tag) => {
      const filteredPosts = await getPostsByTag(tag.name)

      return {
        params: { tag: tag.name },
        props: { page: { data: [...filteredPosts] } }
      }
    })
  )

  // return paginate(allData, { pageSize: 20 })
}

// All paginated data + posts are passed on the "page" prop
const { page } = Astro.props as Props
const { tag } = Astro.params as Params
---

<ArchiveLayout title={`#${tag}`} pageTitle={`#${tag}`} page={page} />
