---
import { InfiniteScroll } from '@/components/infinite-scroll'
import { ArchiveLayout } from '@/components/layouts'
import { metadata } from '@/config'
import { getCollectionEnhanced } from '@/features/posts/lib'

// Load photos for the first page
const photos = await getCollectionEnhanced('photos')
const totalPages = Math.ceil(photos.length / metadata.itemsPerPage)
const firstPagePhotos = photos.slice(0, metadata.itemsPerPage)

// Create page object for the first page
const page = {
  data: firstPagePhotos,
  start: 0,
  end: Math.min(metadata.itemsPerPage - 1, photos.length - 1),
  size: metadata.itemsPerPage,
  total: photos.length,
  currentPage: 1,
  lastPage: totalPages,
  url: {
    current: '/photos/',
    prev: undefined,
    next: totalPages > 1 ? '/photos/2/' : undefined,
    first: '/photos/',
    last: totalPages > 1 ? `/photos/${totalPages}/` : '/photos/'
  }
}
---

<ArchiveLayout title="Photos" pageTitle="Photos" page={page}>
  <InfiniteScroll
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    baseUrl="/photos/"
    contentSelector="#posts"
  />
</ArchiveLayout>
