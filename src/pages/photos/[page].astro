---
import type { GetStaticPathsOptions, Page } from 'astro'
import { ArchiveLayout } from '@/components/layouts'
import { metadata } from '@/config'
import { getCollectionEnhanced } from '@/features/posts/lib'
import type { PhotoPost } from '@/features/posts/types'

type Props = {
  page: Page<PhotoPost>
}

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const photos = await getCollectionEnhanced('photos')
  const pages = paginate(photos, { pageSize: metadata.itemsPerPage })

  // Filter out the first page, it will be handled by index.astro
  return pages.filter((page) => page.params.page !== '1')
}

const { page } = Astro.props
---

<!-- This page is never exposed to users, it's just used to generate the static paths for the photos as it's most simple way to get Astro's image processing working. -->
<ArchiveLayout
  title="Photos"
  pageTitle={`Photos ¦ Page ${page.currentPage} of ${page.lastPage}`}
  page={page}
/>
