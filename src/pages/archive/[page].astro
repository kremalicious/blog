---
import type { GetStaticPathsOptions, Page } from 'astro'
import { metadata } from '@/config'
import { getCollectionEnhanced, sortPosts } from '@/features/posts/lib'
import type { ArticlePost, LinkPost, PhotoPost } from '@/features/posts/types'
import { ArchiveLayout } from '@/layouts'

type Props = {
  page: Page<ArticlePost | LinkPost | PhotoPost>
}

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const articles = await getCollectionEnhanced('articles')
  const links = await getCollectionEnhanced('links')
  const sorted = sortPosts([...articles, ...links])
  return paginate(sorted, { pageSize: metadata.itemsPerPage })
}
// All paginated data + posts are passed on the "page" prop
const { page } = Astro.props as Props
---

<ArchiveLayout
  title="Archive"
  pageTitle={`Archive ¦ Page ${page.currentPage} of ${page.lastPage} `}
  page={page}
/>
