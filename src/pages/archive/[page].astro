---
import type { GetStaticPathsOptions, Page } from 'astro'
import config from '@/config/blog.config'
import { getCollectionEnhanced, sortPosts } from '@/features/posts/lib'
import type {
  ArticleEntry,
  LinkEntry,
  PhotoEntry
} from '@/features/posts/types'
import { ArchiveLayout } from '@/layouts'

type Props = {
  page: Page<ArticleEntry | LinkEntry | PhotoEntry>
}

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const articles = await getCollectionEnhanced('articles')
  const links = await getCollectionEnhanced('links')
  const sorted = sortPosts([...articles, ...links])
  return paginate(sorted, { pageSize: config.itemsPerPage })
}
// All paginated data + posts are passed on the "page" prop
const { page } = Astro.props as Props
---

<ArchiveLayout
  title="Archive"
  pageTitle={`Archive ¦ Page ${page.currentPage} of ${page.lastPage} `}
  page={page}
/>
