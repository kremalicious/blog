---
import Picture from '@/components/Picture/index.astro'
import {
  Changelog,
  PostActions,
  PostMeta,
  PostTitle,
  RelatedPosts,
  Toc
} from '@/features/posts/components'
import type { ArticleEntry } from '@/features/posts/types'
import LayoutBase from '@/layouts/Base/index.astro'
import styles from './index.module.css'

// Allow for both directly passing an ArticleEntry or setting all props separately
type Props = ArticleEntry

const post: Props = Astro.props
const { data, tableOfContents } = post
const { title, date, updated, image, toc, githubLink, changelog } = data
---

<LayoutBase {...data} description={post.leadRaw}>
  <article class={styles.entry}>
    <header>
      <PostTitle title={title} date={date} updated={updated} />
    </header>

    <div class={styles.lead} set:html={post.lead} />

    {
      image && (
        <div class={styles.imageWrapper}>
          <Picture
            class={styles.image}
            width={1028}
            height={460}
            src={image}
            alt={title}
            loading="eager"
          />
        </div>
      )
    }

    {toc && tableOfContents && <Toc tableOfContents={tableOfContents} />}

    <slot />

    {changelog && <Changelog repo={changelog} />}

    <PostMeta post={post} />

    <PostActions githubLink={githubLink as string} />

    <RelatedPosts post={post} />
  </article>
</LayoutBase>
