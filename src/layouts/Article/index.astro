---
import type { MarkdownHeading } from 'astro'
import Picture from '@/components/Picture/index.astro'
import {
  Changelog,
  PostActions,
  PostHeader,
  PostMeta,
  RelatedPosts,
  Toc
} from '@/features/posts/components'
import type { ArticleEntry } from '@/features/posts/types'
import LayoutBase from '@/layouts/Base/index.astro'
import styles from './index.module.css'

type Props = {
  post: ArticleEntry
  headings: MarkdownHeading[]
  lead: string
  leadRaw: string
}

const { post, headings, lead, leadRaw } = Astro.props
const { title, date, updated, image, toc, githubLink, changelog } = post.data
---

<LayoutBase post={post} description={leadRaw}>
  <article class={styles.entry}>
    <PostHeader title={title} date={date} updated={updated} />

    <div class={styles.lead} set:html={lead} />

    {
      image && (
        <div class={styles.imageWrapper}>
          <Picture
            class={styles.image}
            width={1028}
            height={460}
            src={image}
            alt={title}
            loading="eager"
          />
        </div>
      )
    }

    {toc && headings && <Toc headings={headings} />}

    <slot />

    {changelog && <Changelog repo={changelog} />}

    <PostMeta post={post} />

    <PostActions githubLink={githubLink} />

    <RelatedPosts post={post} />
  </article>
</LayoutBase>
