---
import {
  LinkActions,
  PostActions,
  PostMeta,
  PostTitle
} from '@/features/posts/components'
import type { LinkEntry } from '@/features/posts/types'
import stylesArticle from '@/layouts/Article/index.module.css'
import LayoutBase from '@/layouts/Base/index.astro'

type Props = LinkEntry

const post: Props = Astro.props
const { data, slug, leadRaw } = post
const { title, date, updated, githubLink, linkurl } = data
---

<LayoutBase {...data} description={leadRaw}>
  <article class={stylesArticle.entry}>
    <header>
      <PostTitle
        linkurl={linkurl}
        title={title}
        date={date}
        updated={updated}
      />
    </header>

    <slot />

    <LinkActions slug={slug} linkurl={linkurl} />

    <PostMeta post={post} />

    <PostActions githubLink={githubLink as string} />
  </article>
</LayoutBase>
