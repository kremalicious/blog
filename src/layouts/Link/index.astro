---
import {
  LinkActions,
  PostActions,
  PostHeader,
  PostMeta
} from '@/features/posts/components'
import type { LinkPost } from '@/features/posts/types'
import stylesArticle from '@/layouts/Article/index.module.css'
import LayoutBase from '@/layouts/Base/index.astro'

type Props = {
  post: LinkPost
  leadRaw: string
}

const { post, leadRaw } = Astro.props
const { title, date, updated, githubLink, linkurl, slug } = post.data
---

<LayoutBase post={post} description={leadRaw}>
  <article class={stylesArticle.entry}>
    <PostHeader linkurl={linkurl} title={title} date={date} updated={updated} />

    <slot />

    <LinkActions slug={slug} linkurl={linkurl} />

    <PostMeta post={post} />

    <PostActions githubLink={githubLink as string} />
  </article>
</LayoutBase>
