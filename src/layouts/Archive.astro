---
import type { Page } from 'astro'
import Pagination from '@/components/Pagination/index.astro'
import {
  LinkTeaser,
  PhotoTeaser,
  PostTeaser
} from '@/features/posts/components'
import type { BlogEntry } from '@/features/posts/types'
import LayoutBase from '@/layouts/Base/index.astro'
import styles from './Archive.module.css'

type Props = {
  page: Page<BlogEntry>
  title: string
  pageTitle?: string
}

const { page, title, pageTitle } = Astro.props
const isPhotos = title && title !== '' && title.toLowerCase().includes('photos')
const classes = `${styles.posts} ${isPhotos ? styles.photos : ''}`
---

<LayoutBase title={title} pageTitle={pageTitle}>
  <div id="posts" class={classes}>
    {
      page?.data?.map((post) =>
        post.collection === "photos" ? (
          <PhotoTeaser post={post} />
        ) : post.collection === "links" ? (
          <LinkTeaser post={post} />
        ) : (
          <PostTeaser post={post} />
        )
      )
    }
  </div>

  {
    page.currentPage && !isPhotos && (
      <Pagination
        currentPage={page.currentPage}
        numPages={page.lastPage}
        slug={`/${Astro.url.pathname.split("/")[1]}`}
      />
    )
  }

  <slot />
</LayoutBase>
