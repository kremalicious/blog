---
import Picture from '@/components/Picture/index.astro'
import { Exif, PhotoNav, PostHeader } from '@/features/posts/components'
import type { ImageMetadataFormatted, PhotoEntry } from '@/features/posts/types'
import stylesArticle from '@/layouts/Article/index.module.css'
import LayoutBase from '@/layouts/Base/index.astro'

type Props = {
  post: PhotoEntry
  leadRaw: string
}

const { post, leadRaw } = Astro.props
const { title, date, updated, image, imageMetadata } = post.data
---

<LayoutBase post={post} description={leadRaw}>
  <article class={stylesArticle.entry}>
    <header>
      <PostHeader title={title} date={date} updated={updated} />
    </header>

    <slot />

    <div class={stylesArticle.imageWrapper}>
      <Picture
        class={stylesArticle.image}
        width={1028}
        height={460}
        src={image}
        alt={title}
        loading="eager"
      />
    </div>

    <Exif imageMetadata={imageMetadata as ImageMetadataFormatted} />

    <PhotoNav currentPhoto={post} />
  </article>
</LayoutBase>
