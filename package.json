{
  "name": "@kremalicious/blog",
  "version": "5.0.0",
  "author": "Matthias Kretschmann <m@kretschmann.io>",
  "description": "Blog of Designer & Developer Matthias Kretschmann",
  "homepage": "https://kremalicious.com",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run prebuild && astro dev --config 'config/astro.config.ts'",
    "build": "astro build --config 'config/astro.config.ts'",
    "preview": "astro preview",
    "typecheck:astro": "astro check",
    "typecheck:tsc": "tsc --noEmit --pretty",
    "typecheck": "bun run typecheck:astro && bun run typecheck:tsc",
    "prebuild": "run-p --silent --continue-on-error create:symlinks create:icons move:downloads",
    "test:unit": "vitest run --config './test/vitest.config.ts' --coverage",
    "test:unit:watch": "vitest watch --config './test/vitest.config.ts' --coverage",
    "test:e2e": "playwright test --config './test/playwright.config.ts'",
    "lint:md": "markdownlint --config 'config/markdownlint.json' --ignore-path .gitignore --dot './**/*.{md,markdown}'",
    "lint:biome": "biome check .",
    "lint": "run-p --silent lint:biome lint:md",
    "format": "biome check --write .",
    "deploy:s3": "./scripts/deploy-s3.sh",
    "new": "bun run scripts/new/index.ts",
    "create:icons": "bun run scripts/create-icons/index.ts",
    "create:redirects": "bun run scripts/redirect-from.ts",
    "create:symlinks": "./scripts/create-symlinks.sh",
    "move:downloads": "bun run scripts/move-downloads.ts",
    "iptc:add": "bun run scripts/iptc-add.ts"
  },
  "dependencies": {
    "@astrojs/check": "0.9.4",
    "@astrojs/react": "4.3.1",
    "@astrojs/rss": "4.0.12",
    "@astrojs/sitemap": "3.5.1",
    "@coingecko/cryptoformat": "0.8.2",
    "@nanostores/persistent": "1.1.0",
    "@nanostores/query": "0.3.4",
    "@nanostores/react": "1.0.0",
    "@radix-ui/react-select": "2.2.6",
    "@rainbow-me/rainbowkit": "2.2.8",
    "@tanstack/react-query": "5.87.4",
    "astro": "5.13.7",
    "astro-expressive-code": "0.41.3",
    "astro-redirect-from": "1.3.3",
    "date-fns": "4.1.0",
    "feather-icons": "4.29.2",
    "fraction.js": "5.3.4",
    "fuse.js": "7.1.0",
    "nanostores": "1.0.1",
    "pigeon-maps": "0.22.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "slugify": "1.6.6",
    "swr": "2.3.6",
    "viem": "2.37.5",
    "wagmi": "2.16.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@kremalicious/config": "2.0.0",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/bun": "1.2.22",
    "@types/node": "24.4.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "chalk": "5.6.2",
    "exifr": "7.1.3",
    "exiftool-vendored": "30.5.0",
    "globby": "14.1.0",
    "hast-util-to-html": "^9.0.5",
    "jsdom": "26.1.0",
    "markdownlint-cli": "0.45.0",
    "mdast-util-to-hast": "13.2.0",
    "mdast-util-to-string": "4.0.0",
    "mdast-util-toc": "7.1.0",
    "npm-run-all": "4.1.5",
    "ora": "8.2.0",
    "sharp": "0.33.5",
    "sharp-ico": "0.1.5",
    "svgo": "3.3.2",
    "typescript": "5.9.2",
    "unist-util-visit": "5.0.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "engines": {
    "bun": ">=1.2.20"
  },
  "packageManager": "bun@1.2.20",
  "repository": {
    "type": "git",
    "url": "https://github.com/kremalicious/blog.git"
  },
  "browserslist": {
    "production": [
      "defaults",
      ">0.2%"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
